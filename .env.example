# Copy this file to ".env" (same folder) and paste your key after the = sign.
# No quotes, no spaces.

# Which LLM to use: groq (recommended, fastest) | gemini | ollama
LLM_PROVIDER=groq

# Get a free Groq key at https://console.groq.com/keys   (it starts with gsk_)
GROQ_API_KEY= your_groq_key_here

# Only needed if LLM_PROVIDER=gemini  (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the model name if the default is ever retired
LLM_MODEL=openai/gpt-oss-120b

# Optional: set to 0 if installing "fastembed" fails (keyword search only)
# USE_EMBEDDINGS=1

# Screenshot reading (OCR) happens once inside ingest.py. Set to 0 to skip it.
# USE_OCR=1
# Only needed if Tesseract is installed in an unusual folder (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
